<%- include('../partials/header') %>

<div class="container mt-4">
    <h1 class="mb-1">Welcome back, <%= user.username %></h1>
    <p class="text-muted mb-4">Here's how this month is looking so far.</p>

    <div class="row mb-4">
        <div class="col-md-5 mb-3">
            <div class="rounded-4 p-4 donut-card h-100 d-flex flex-column align-items-center justify-content-center text-center">
                <p class="text-uppercase small mb-3 donut-label">Budget Usage</p>
                <svg viewBox="0 0 200 200" width="180" height="180">
                    <circle r="80" cx="100" cy="100" fill="transparent" stroke="rgba(255,255,255,0.15)" stroke-width="20" />
                    <circle r="80" cx="100" cy="100" fill="transparent"
                            stroke="<%= budget_used_percent > 100 ? '#f0946b' : '#a7f3d0' %>"
                            stroke-width="20"
                            stroke-dasharray="<%= donut_dash_array %>"
                            stroke-linecap="round"
                            transform="rotate(-90 100 100)" />
                    <text x="100" y="95" text-anchor="middle" font-size="34" font-weight="700" fill="white">$<%= total_expense %></text>
                    <text x="100" y="120" text-anchor="middle" font-size="12" fill="rgba(255,255,255,0.7)">spent of $<%= budget %> budget</text>
                </svg>
                <% if (budget == 0) { %>
                <p class="small mt-3 mb-0 donut-label">No budget set yet &mdash; <strong>set one below</strong> to start tracking your progress.</p>
                <% } %>
            </div>
        </div>

        <div class="col-md-7">
            <div class="row h-100">
                <div class="col-sm-6 mb-3">
                    <div class="rounded-4 p-3 stat-card h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="stat-icon">💳</span>
                            <span class="badge-pill-soft">This month</span>
                        </div>
                        <p class="text-muted small mb-1">Total spending</p>
                        <h3 class="dollar-amount mb-0">$<%= total_expense %></h3>
                    </div>
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="rounded-4 p-3 stat-card h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="stat-icon">⚠️</span>
                            <% if (remaining < 0) { %><span class="badge-pill-warning">Over</span><% } %>
                        </div>
                        <p class="text-muted small mb-1">Remaining savings</p>
                        <h3 class="dollar-amount mb-0" style="<%= remaining < 0 ? 'color:#e0654a;' : '' %>">$<%= remaining %></h3>
                    </div>
                </div>
                <div class="col-12">
                    <div class="rounded-4 p-3 stat-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="stat-icon">🎯</span>
                            <span class="badge-pill-soft"><%= transaction_count %> transaction<%= transaction_count === 1 ? '' : 's' %></span>
                        </div>
                        <p class="text-muted small mb-1">Monthly budget</p>
                        <h3 class="dollar-amount mb-0">$<%= budget %> <span class="fs-6 text-muted fw-normal"><%= budget == 0 ? '\u2014 not set' : '' %></span></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="border rounded-4 p-4">
                <h5 class="mb-3">Add expense</h5>
                <form method="POST" action="/add-expense" id="add-expense-form">
                    <label class="form-label small text-muted">Amount</label>
                    <div class="input-group mb-3">
                        <span class="input-group-text">$</span>
                        <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" required>
                    </div>

                    <label class="form-label small text-muted">Category</label>
                    <input type="hidden" name="category" id="category-input" value="Food">
                    <div class="category-pill-grid mb-3">
                        <button type="button" class="category-pill active" data-value="Food">Food</button>
                        <button type="button" class="category-pill" data-value="Rent">Rent</button>
                        <button type="button" class="category-pill" data-value="Insurance">Insurance</button>
                        <button type="button" class="category-pill" data-value="Subscription">Subscription</button>
                        <button type="button" class="category-pill" data-value="Other">+ Other</button>
                    </div>

                    <div class="mb-3" id="custom-category-wrap" style="display:none;">
                        <label class="form-label small text-muted">Custom category</label>
                        <input type="text" name="custom_category" class="form-control" placeholder="e.g. Gym membership">
                    </div>

                    <label class="form-label small text-muted">Date</label>
                    <input type="date" name="date" class="form-control mb-3">

                    <button type="submit" class="btn btn-brand-solid w-100">Add expense</button>
                </form>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="border rounded-4 p-4">
                <h5 class="mb-3">Set monthly budget</h5>
                <form method="POST" action="/" class="mb-4">
                    <label class="form-label small text-muted">Budget amount</label>
                    <div class="input-group mb-3">
                        <span class="input-group-text">$</span>
                        <input type="number" step="0.01" name="budget_amount" class="form-control" value="<%= budget %>" required>
                    </div>
                    <button type="submit" class="btn btn-brand-solid w-100">Save budget</button>
                </form>

                <div class="assistant-box rounded-4 p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="assistant-icon">✦</span>
                        <div>
                            <p class="mb-0 fw-bold small">Assistant</p>
                            <p class="mb-0 text-muted" style="font-size:11px;">Ask about spending, budgets, savings</p>
                        </div>
                    </div>

                    <div class="bg-white rounded-3 p-3 mb-2 small">
                        Hi &mdash; I'm your financial assistant. Ask me anything about your spending, budgeting, or savings.
                    </div>

                    <% if (ai_response) { %>
                    <div class="bg-white rounded-3 p-3 mb-2 small">
                        <p class="fw-bold mb-1">You asked: <%= question %></p>
                        <p class="mb-0"><%= ai_response %></p>
                    </div>
                    <% } %>

                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="quick-chip" data-question="Where can I cut back?">Where can I cut back?</button>
                        <button type="button" class="quick-chip" data-question="Set a budget for me">Set a budget for me</button>
                        <button type="button" class="quick-chip" data-question="Am I on track this month?">Am I on track this month?</button>
                    </div>

                    <form method="POST" action="/ask-ai" class="d-flex gap-2">
                        <input type="text" name="question" id="ai-question-input" class="form-control" placeholder="Ask a question...">
                        <button type="submit" class="btn btn-brand-solid">➤</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>